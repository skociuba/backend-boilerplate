POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mydb

# Lokalne połączenie (poza dockerem), port 5433 z docker-compose.override.yml
DATABASE_URL=postgres://myuser:changeme@localhost:5433/mydb

# Dwa RÓŻNE sekrety — access i refresh token muszą być podpisywane osobno.
# Wygeneruj własne, nigdy nie używaj tych z przykładu:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Wysyłka maili (aktywacja konta, reset hasła). Trzy warianty:
# 1) MailDev lokalnie (polecane do pracy na co dzień) — odpal
#    `docker compose up -d maildev` (patrz docker-compose.override.yml),
#    ustaw SMTP_HOST=localhost, SMTP_PORT=1025, i otwórz
#    http://localhost:1080 — zwykła strona w przeglądarce, bez logowania,
#    widzisz tam KAŻDY mail wysłany przez backend.
# 2) Pusty SMTP_HOST = fallback na jednorazowe konto testowe na
#    ethereal.email (zero setupu, ale trzeba kliknąć link podglądu
#    wypisywany w konsoli backendu, nie ma stałego inboxa).
# 3) Realny dostawca (Resend/SendGrid/SES/własny SMTP) — wypełnij
#    SMTP_HOST/PORT/USER/PASS danymi od dostawcy. Mechanizm w kodzie
#    (lib/mailer.ts) się NIE zmienia — zawsze zwykłe SMTP.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# Frontend URL do budowania linków w mailach (/activate?token=..., /reset-password?token=...)
FRONTEND_URL=http://localhost:3001

# Sentry (src/instrument.ts) — DSN z ustawień projektu w sentry.io.
# Puste = Sentry wyłączony (lokalnie zwykle tak zostaje).
SENTRY_DSN=

# Poziom logów: debug | info | warn | error (domyślnie info)
LOG_LEVEL=info
