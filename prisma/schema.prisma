generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Wewnętrzna tabela node-pg-migrate (śledzi zastosowane migracje) — nie
/// nasza domena. @@ignore mówi Prisma Client "wiem że ta tabela istnieje,
/// ale nie generuj dla niej żadnych metod" — bezpieczniejsze niż usunięcie
/// modelu, bo `db push`/`migrate dev` nie potraktuje jej jako "do skasowania".
model pgmigrations {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)

  @@ignore
}

model post_tags {
  post_id Int
  tag_id  Int
  posts   posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags    tags  @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, tag_id])
  @@index([tag_id], map: "post_tags_tag_id_index")
}

model posts {
  id         Int         @id @default(autoincrement())
  user_id    Int
  title      String      @db.VarChar(255)
  content    String?
  created_at DateTime    @default(now()) @db.Timestamp(6)
  post_tags  post_tags[]
  users      users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "posts_user_id_index")
}

model tags {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(50)
  post_tags post_tags[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_profiles {
  user_id       Int      @id
  pesel         String   @unique @db.VarChar(11)
  date_of_birth DateTime @db.Date
  phone         String?  @db.VarChar(20)
  bio           String?  @db.Text
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  posts         posts[]
  user_profiles user_profiles?
}
