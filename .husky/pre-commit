# Przy każdym commicie (Twoim i Claude): blokuje commit na master/main i na
# branchu o złej nazwie (reguła w branch-name.sh). Commity Claude dodatkowo
# sprawdza .claude/hooks/naming-guard.py, zanim polecenie w ogóle ruszy.

. "$(dirname "$0")/branch-name.sh"

# Detached HEAD (rebase, cherry-pick) — nie ma brancha do sprawdzenia
if branch=$(git symbolic-ref --short HEAD 2>/dev/null); then
  if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
    echo "✖ Nie commitujemy bezpośrednio na $branch — zmiany wchodzą przez PR."
    echo "  Przenieś pracę na branch: git switch -c feat/<opis>"
    exit 1
  fi
  check_branch_name "$branch" || exit 1
fi
